# ========================================
# Docker 镜像配置文件 (由 init-env.sh 自动生成)
# ========================================

# 用户配置（与主机用户保持一致，避免权限问题）
USER_NAME=nvidia
USER_UID=1000
USER_GID=1000

# Docker 镜像配置
IMAGE_NAME=sd-humble-image
IMAGE_TAG=latest
CONTAINER_NAME=sd-humble-container

# ROS 配置 (如果使用 ROS 模板)
ROS_DISTRO=humble

# GUI 支持
ENABLE_GUI=true

# GPU 支持 (需要 nvidia-docker2)
ENABLE_GPU=false

# 提升权限 (危险：仅在确实需要时启用)
ENABLE_PRIVILEGED=false

# 挂载 Docker Socket
MOUNT_DOCKER_SOCK=false

# 工作空间目录 (挂载到容器中的目录)
WORKSPACE_DIR=/home/nvidia/colcon_ws

# 容器内的工作目录名称 (挂载到 /home//)
CONTAINER_WORKSPACE=workspace

# 共享内存大小
#SHM_SIZE=2g

# IPC 模式
IPC_MODE=host
